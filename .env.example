# Environment variables for the admin analytics dashboard (/admin/).
#
# These live in Vercel > Project > Settings > Environment Variables, not in the
# repository. Copy this file to `.env.local` only if you run `vercel dev`.
#
# Every one of these is a server-side secret. None is prefixed with VITE_, so
# Vite cannot expose any of them to the browser bundle.

# Supabase project `pp_a` (ap-northeast-2). Not a secret — it is the public
# endpoint — but it is server-side here because only the functions call it.
SUPABASE_URL=https://kimusrivsubyghfhrwng.supabase.co

# Supabase > Project Settings > API Keys > service_role.
# Bypasses row level security. Never put this in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Admin sign-in. The password is stored only as a scrypt hash; regenerate both
# with the one-liner in docs/admin-analytics.md.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Signs the session cookie and salts the stored IP hashes.
# Changing it signs everyone out and re-anonymises future IP hashes.
ADMIN_SESSION_SECRET=

# Optional. Addresses whose visits are never recorded — the operator's own.
# Comma- or whitespace-separated; empty disables the check. This backs up the
# per-browser switch in the dashboard, which survives an IP change.
ANALYTICS_EXCLUDE_IPS=
